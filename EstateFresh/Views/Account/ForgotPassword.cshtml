@model EstateFresh.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password - Estate Fresh";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-leaf fa-2x" style="color: #5F7D69;"></i>
                        <h2 class="mt-2" style="font-family: 'Playfair Display', serif;">Forgot Password</h2>
                        <p class="text-muted">Enter your email to receive a reset link</p>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    <form asp-action="ForgotPassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 rounded-start-3">
                                    <i class="fa-regular fa-envelope text-muted"></i>
                                </span>
                                <input asp-for="Email" class="form-control border-start-0 rounded-end-3"
                                       type="email" placeholder="you@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                            <i class="fa-solid fa-paper-plane me-2"></i>Send Reset Link
                        </button>

                        <div class="text-center mt-3">
                            <a asp-action="Login" class="small text-muted">
                                <i class="fa-solid fa-arrow-left me-1"></i>Back to Login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}