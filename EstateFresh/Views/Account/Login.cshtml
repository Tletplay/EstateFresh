@model EstateFresh.Models.LoginViewModel

@{
    ViewData["Title"] = "Login - Estate Fresh";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <i class="fa-solid fa-leaf fa-2x" style="color: #5F7D69;"></i>
                        <h2 class="mt-2" style="font-family: 'Playfair Display', serif;">Welcome Back</h2>
                        <p class="text-muted">Sign in to continue to Estate Fresh</p>
                    </div>

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    <form asp-action="Login" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 rounded-start-3">
                                    <i class="fa-regular fa-envelope text-muted"></i>
                                </span>
                                <input asp-for="Email" class="form-control border-start-0 rounded-end-3"
                                       type="email" placeholder="you@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 rounded-start-3">
                                    <i class="fa-solid fa-lock text-muted"></i>
                                </span>
                                <input asp-for="Password" class="form-control border-start-0 rounded-end-3"
                                       type="password" placeholder="••••••" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label text-muted">Remember me</label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Login
                        </button>

                        <div class="text-center mt-3">
                            <a asp-action="ForgotPassword" class="small text-muted">Forgot Password?</a>
                        </div>

                        <hr class="my-4" />

                        <div class="text-center">
                            <span class="text-muted">Don't have an account? </span>
                            <a asp-action="Register" class="fw-semibold" style="color: #5F7D69;">Create one</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}