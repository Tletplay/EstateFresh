@model EstateFresh.Models.Service

@{
    ViewData["Title"] = "Edit Service";
    Layout = "_AdminLayout";
}

<h2 style="font-family: 'Playfair Display', serif;">Edit Service</h2>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="EditService" asp-controller="Admin" method="post">
            <input type="hidden" asp-for="ServiceID" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Rate per Kg (R)</label>
                <input asp-for="RatePerKg" class="form-control" type="number" step="0.01" />
            </div>

            <div class="mb-3">
                <label class="form-label">Rate per Item (R)</label>
                <input asp-for="RatePerItem" class="form-control" type="number" step="0.01" />
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Save Changes
                </button>
                <a href="@Url.Action("ManageServices")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>