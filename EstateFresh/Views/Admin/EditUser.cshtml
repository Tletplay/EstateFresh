@model EstateFresh.Models.User

@{
    ViewData["Title"] = "Edit User";
    Layout = "_AdminLayout";
}

<h2 style="font-family: 'Playfair Display', serif;">Edit User</h2>

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <p><strong>Name:</strong> @Model.FullName</p>
        <p><strong>Email:</strong> @Model.Email</p>

        <form asp-action="EditUser" asp-controller="Admin" method="post">
            <input type="hidden" name="userID" value="@Model.UserID" />

            <div class="mb-3">
                <label class="form-label">Role</label>
                <select name="role" class="form-select">
                    <option value="Customer" selected="@(Model.Role == "Customer")">Customer</option>
                    <option value="Driver" selected="@(Model.Role == "Driver")">Driver</option>
                    <option value="Manager" selected="@(Model.Role == "Manager")">Manager</option>
                    <option value="Admin" selected="@(Model.Role == "Admin")">Admin</option>
                </select>
            </div>

            <div class="mb-3 form-check">
                <input type="checkbox" name="isActive" value="true" class="form-check-input" id="isActiveCheck" checked="@Model.IsActive" />
                <label class="form-check-label" for="isActiveCheck">Account Active</label>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-check"></i> Save Changes
                </button>
                <a href="@Url.Action("ManageUsers")" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>