@model IEnumerable<EstateFresh.Models.Order>

@{
    ViewData["Title"] = "My Orders - Estate Fresh";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 style="font-family: 'Playfair Display', serif;">My Orders</h2>
        <a href="@Url.Action("BookPickup", "Order")" class="btn btn-primary">
            <i class="fa-solid fa-plus me-2"></i>New Order
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-5 text-center">
                <i class="fa-solid fa-shirt fa-3x mb-3" style="color: #A8C3A0;"></i>
                <h3 style="font-family: 'Playfair Display', serif;">No Orders Yet</h3>
                <p class="text-muted">You haven't placed any laundry orders.</p>
                <a href="@Url.Action("BookPickup", "Order")" class="btn btn-primary mt-2">Book Your First Pickup</a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var order in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="fw-bold mb-0">Order #@order.OrderID</h5>
                                <span class="badge @(order.Status == "Completed" ? "bg-success" : order.Status == "Delivered" ? "bg-info" : "bg-warning")">
                                    @order.Status
                                </span>
                            </div>

                            <p class="mb-2">
                                <i class="fa-solid fa-tag me-2" style="color: #5F7D69;"></i>
                                <strong>Service:</strong> @order.Service?.Name
                            </p>

                            <p class="mb-2">
                                <i class="fa-regular fa-calendar me-2" style="color: #5F7D69;"></i>
                                <strong>Created:</strong> @order.CreatedAt.ToString("dd MMM yyyy")
                            </p>

                            @if (order.ActualWeightKg.HasValue)
                            {
                                <p class="mb-2">
                                    <i class="fa-solid fa-weight-hanging me-2" style="color: #5F7D69;"></i>
                                    <strong>Weight:</strong> @order.ActualWeightKg.Value kg
                                </p>
                            }

                            <p class="mb-2">
                                <i class="fa-solid fa-credit-card me-2" style="color: #5F7D69;"></i>
                                <strong>Deposit:</strong> R@(string.Format("{0:F2}", order.DepositPaid))
                            </p>

                            @if (order.BalanceDue.HasValue && order.BalanceDue.Value > 0 && !order.BalancePaid && order.Status != "Deposit Paid")
                            {
                                <p class="mb-2 text-danger">
                                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                                    <strong>Balance Due:</strong> R@(order.BalanceDue.Value.ToString("0.00"))
                                </p>
                            }

                            <hr />

                            @* === PAY BALANCE BUTTON (ADDED) === *@
                            @if (order.BalanceDue.HasValue && order.BalanceDue.Value > 0 && !order.BalancePaid && order.Status != "Deposit Paid")
                            {
                                <a href="@Url.Action("PayBalance", "Payment", new { orderId = order.OrderID })"
                                   class="btn btn-warning btn-sm w-100 mt-2">
                                    <i class="fa-solid fa-credit-card me-1"></i>Pay Balance (R@(order.BalanceDue.Value.ToString("0.00")))
                                </a>
                            }

                            <a href="@Url.Action("OrderDetails", "Order", new { orderId = order.OrderID })" class="btn btn-sm btn-outline-primary w-100">
                                <i class="fa-solid fa-eye me-1"></i>Track Order
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>