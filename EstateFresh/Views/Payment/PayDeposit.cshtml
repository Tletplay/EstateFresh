@{
    ViewData["Title"] = "Pay Deposit - Estate Fresh";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>Pay Deposit - Estate Fresh</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-5 text-center">
                        <i class="fa-solid fa-credit-card fa-3x mb-3" style="color: #5F7D69;"></i>
                        <h3 style="font-family: 'Playfair Display', serif;">Pay R50 Deposit</h3>
                        <p class="text-muted">Order #@ViewBag.OrderId</p>

                        <form action="https://sandbox.payfast.co.za/eng/process" method="post">
                            <input type="hidden" name="merchant_id" value="10000100" />
                            <input type="hidden" name="merchant_key" value="46f0cd694581a" />
                            <input type="hidden" name="return_url" value="https://localhost:7169/Payment/Confirm?orderId=@ViewBag.OrderId" />
                            <input type="hidden" name="cancel_url" value="https://localhost:7169/Payment/Cancel" />
                            <input type="hidden" name="notify_url" value="https://localhost:7169/Payment/Notify" />
                            <input type="hidden" name="m_payment_id" value="@ViewBag.OrderId" />
                            <input type="hidden" name="amount" value="50.00" />
                            <input type="hidden" name="item_name" value="Estate Fresh - Order #@ViewBag.OrderId Deposit" />
                            <input type="hidden" name="email_address" value="@ViewBag.CustomerEmail" />

                            <button type="submit" class="btn btn-primary w-100 py-2">
                                <i class="fa-brands fa-paypal me-2"></i>Pay R50 with PayFast
                            </button>
                        </form>

                        <p class="mt-4 small text-muted">
                            Test card: 4111 1111 1111 1111<br />
                            Any expiry date | CVV: 111
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</body>
</html>