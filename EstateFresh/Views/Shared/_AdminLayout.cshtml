@{
    var role = Context.Session.GetString("Role");
    var fullName = Context.Session.GetString("FullName");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Estate Fresh</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/estatefresh.css" />

    <style>
        body {
            background-color: #FAFAF7;
        }

        .admin-shell {
            display: flex;
            min-height: 100vh;
        }

        .admin-sidebar {
            width: 240px;
            background-color: #FFFFFF;
            border-right: 1px solid #eee;
            display: flex;
            flex-direction: column;
            padding: 1.5rem 1rem;
            position: sticky;
            top: 0;
            height: 100vh;
        }

            .admin-sidebar .brand {
                font-family: 'Playfair Display', serif;
                font-size: 1.3rem;
                font-weight: 600;
                color: #5F7D69;
                margin-bottom: 2rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

        .admin-nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.65rem 0.9rem;
            border-radius: 12px;
            color: #2B2B2B;
            text-decoration: none;
            font-weight: 500;
            margin-bottom: 0.25rem;
            transition: all 0.15s ease;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
        }

            .admin-nav-link:hover {
                background-color: #F5F5F0;
                color: #5F7D69;
            }

            .admin-nav-link.active {
                background-color: #A8C3A0;
                color: #2B2B2B;
            }

        .admin-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .admin-topbar {
            background-color: #FFFFFF;
            border-bottom: 1px solid #eee;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .admin-content {
            padding: 2rem;
            flex: 1;
        }

        .sidebar-toggle {
            display: none;
        }

        @@media (max-width: 768px) {
            .admin-sidebar {
                position: fixed;
                left: -240px;
                z-index: 1050;
                transition: left 0.2s ease;
            }

                .admin-sidebar.show {
                    left: 0;
                }

            .sidebar-toggle {
                display: inline-block;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-shell">
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="brand">
                <i class="fa-solid fa-leaf"></i> Estate Fresh
            </div>

            <nav class="flex-grow-1">
                @if (role == "Admin")
                {
                    <a class="admin-nav-link" asp-controller="Admin" asp-action="Index">
                        <i class="fa-solid fa-gauge"></i> Dashboard
                    </a>
                    <a class="admin-nav-link" asp-controller="Admin" asp-action="ManageUsers">
                        <i class="fa-solid fa-users"></i> Manage Users
                    </a>
                    <a class="admin-nav-link" asp-controller="Admin" asp-action="ManageServices">
                        <i class="fa-solid fa-shirt"></i> Manage Services
                    </a>
                    <a class="admin-nav-link" asp-controller="Admin" asp-action="StorageOrders">
                        <i class="fa-solid fa-box-open"></i> Unclaimed Laundry
                    </a>
                }
                @if (role == "Manager")
                {
                    <a class="admin-nav-link" asp-controller="Manager" asp-action="Index">
                        <i class="fa-solid fa-gauge"></i> Dashboard
                    </a>
                    <a class="admin-nav-link" asp-controller="Manager" asp-action="WeightDisputes">
                        <i class="fa-solid fa-scale-unbalanced"></i> Weight Disputes
                    </a>
                    <a class="admin-nav-link" asp-controller="Manager" asp-action="Reports">
                        <i class="fa-solid fa-chart-line"></i> Reports
                    </a>
                }
            </nav>

            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="admin-nav-link">
                    <i class="fa-solid fa-sign-out-alt"></i> Logout
                </button>
            </form>
        </aside>

        <div class="admin-main">
            <div class="admin-topbar">
                <button class="btn btn-sm sidebar-toggle" onclick="document.getElementById('adminSidebar').classList.toggle('show')">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h5 class="mb-0" style="font-family: 'Playfair Display', serif;">@ViewData["Title"]</h5>
                <div class="d-flex align-items-center gap-2">
                    <i class="fa-regular fa-user-circle fa-lg" style="color:#5F7D69;"></i>
                    <div>
                        <div class="fw-semibold" style="line-height:1;">@fullName</div>
                        <small class="text-muted">@role</small>
                    </div>
                </div>
            </div>

            <div class="admin-content">
                @RenderBody()
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>